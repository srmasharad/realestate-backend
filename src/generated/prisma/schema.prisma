// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  AGENT
  ADMIN
}

enum ListingType {
  RENT
  SALE
}

enum PropertyType {
  HOUSE
  UNIT
  TOWNHOUSE
  APARTMENT
  COMMERCIAL
  LAND
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserMediaType {
  PROFILE_IMAGE
}

enum PropertyMediaType {
  IMAGE
}

enum MediaVisibility {
  PUBLIC
  PROTECTED
}

enum AgencyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AgencyMemberRole {
  AGENCY_OWNER
  AGENCY_ADMIN
  AGENT
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  fullName        String
  passwordHash    String?
  phone           String?  @unique
  googleId        String?  @unique
  role            UserRole @default(USER)
  isActive        Boolean  @default(true)
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  properties              Property[]
  profile                 PersonProfile?
  applications            Application[]
  emailVerificationTokens EmailVerificationToken[]
  media                   UserMedia[]
  agencyMemberships       AgencyMember[]
}

model UserMedia {
  id         String          @id @default(uuid())
  userId     String
  mediaType  UserMediaType
  visibility MediaVisibility
  url        String
  publicId   String
  isPrimary  Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PersonProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  fullName         String
  phone            String
  addressLine1     String
  suburb           String
  state            String
  postcode         String
  employmentStatus String
  monthlyIncome    Decimal  @db.Decimal(12, 2)
  householdSize    Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Property {
  id            String       @id @default(uuid())
  title         String
  description   String
  listingType   ListingType
  propertyType  PropertyType
  price         Decimal      @db.Decimal(12, 2)
  addressLine1  String
  suburb        String
  state         String
  postcode      String
  bedrooms      Int?
  bathrooms     Int?
  parkingSpaces Int?
  isPublished   Boolean      @default(false)
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  application Application[]
  media       PropertyMedia[]
}

model Application {
  id          String            @id @default(uuid())
  propertyId  String
  applicantId String
  status      ApplicationStatus @default(PENDING)
  message     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  applicant User     @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([propertyId, applicantId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PropertyMedia {
  id         String            @id @default(uuid())
  propertyId String
  mediaType  PropertyMediaType
  visibility MediaVisibility
  url        String
  publicId   String
  isPrimary  Boolean           @default(false)
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Agency {
  id           String       @id @default(uuid())
  name         String
  slug         String       @unique
  email        String       @unique
  phone        String?
  addressLine1 String?
  suburb       String?
  state        String?
  postcode     String?
  status       AgencyStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  members AgencyMember[]
}

model AgencyMember {
  id        String           @id @default(uuid())
  agencyId  String
  userId    String
  role      AgencyMemberRole
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  AGENT
  ADMIN
}

enum ListingType {
  RENT
  SALE
}

enum PropertyType {
  HOUSE
  UNIT
  TOWNHOUSE
  APARTMENT
  COMMERCIAL
  LAND
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserMediaType {
  PROFILE_IMAGE
}

enum PropertyMediaType {
  IMAGE
}

enum MediaVisibility {
  PUBLIC
  PROTECTED
}

enum AgencyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AgencyMemberRole {
  AGENCY_OWNER
  AGENCY_ADMIN
  AGENT
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum PaymentRequestStatus {
  PENDING
  PAID
  CANCELLED
  OVERDUE
}

enum LeaseAgreementStatus {
  DRAFT
  SENT
  SIGNED
  CANCELLED
}

enum TenancyStatus {
  ACTIVE
  ENDED
  CANCELLED
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  fullName           String
  passwordHash       String?
  phone              String?  @unique
  googleId           String?  @unique
  role               UserRole @default(USER)
  isActive           Boolean  @default(true)
  isEmailVerified    Boolean  @default(false)
  mustChangePassword Boolean  @default(false)

  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  properties              Property[]
  profile                 PersonProfile?
  applications            Application[]
  emailVerificationTokens EmailVerificationToken[]
  media                   UserMedia[]
  agencyMemberships       AgencyMember[]
  passwordResetTokens     PasswordResetToken[]
  offers                  Offer[]
  paymentRequests         PaymentRequest[]
  leaseAgreements         LeaseAgreement[]
  tenancies               Tenancy[]

  createdLeaseAgreements LeaseAgreement[] @relation("LeaseCreatedBy")
  sentLeaseAgreements    LeaseAgreement[] @relation("LeaseSentBy")
  signedLeaseAgreements  LeaseAgreement[] @relation("LeaseSignedBy")
}

model UserMedia {
  id         String          @id @default(uuid())
  userId     String
  mediaType  UserMediaType
  visibility MediaVisibility
  url        String
  publicId   String
  isPrimary  Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PersonProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  fullName         String
  phone            String
  addressLine1     String
  suburb           String
  state            String
  postcode         String
  employmentStatus String
  monthlyIncome    Decimal  @db.Decimal(12, 2)
  householdSize    Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Property {
  id            String       @id @default(uuid())
  title         String
  description   String
  listingType   ListingType
  propertyType  PropertyType
  price         Decimal      @db.Decimal(12, 2)
  addressLine1  String
  suburb        String
  state         String
  postcode      String
  bedrooms      Int?
  bathrooms     Int?
  parkingSpaces Int?
  isPublished   Boolean      @default(false)
  isLocked      Boolean      @default(false)
  isArchived    Boolean      @default(false)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  assignedAgentMemberId String?
  assignedAgentMember   AgencyMember? @relation("AssignedPropertyAgent", fields: [assignedAgentMemberId], references: [id], onDelete: SetNull)

  application     Application[]
  media           PropertyMedia[]
  offers          Offer[]
  paymentRequests PaymentRequest[]
  leaseAgreements LeaseAgreement[]
  tenancies       Tenancy[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Application {
  id          String            @id @default(uuid())
  propertyId  String
  applicantId String
  status      ApplicationStatus @default(PENDING)
  message     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  applicant User     @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  offer Offer?

  @@unique([propertyId, applicantId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PropertyMedia {
  id         String            @id @default(uuid())
  propertyId String
  mediaType  PropertyMediaType
  visibility MediaVisibility
  url        String
  publicId   String
  isPrimary  Boolean           @default(false)
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Agency {
  id           String       @id @default(uuid())
  name         String
  slug         String       @unique
  email        String       @unique
  phone        String?
  addressLine1 String?
  suburb       String?
  state        String?
  postcode     String?
  status       AgencyStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  members   AgencyMember[]
  property  Property[]
  tenancies Tenancy[]
}

model AgencyMember {
  id        String           @id @default(uuid())
  agencyId  String
  userId    String
  role      AgencyMemberRole
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  agency             Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedProperties Property[] @relation("AssignedPropertyAgent")

  @@unique([agencyId, userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Offer {
  id            String @id @default(uuid())
  applicationId String
  propertyId    String
  applicantId   String

  status OfferStatus @default(PENDING)

  weeklyRent  Decimal @db.Decimal(12, 2)
  bondAmount  Decimal @db.Decimal(12, 2)
  advanceRent Decimal @db.Decimal(12, 2)

  leaseStartDate DateTime
  leaseEndDate   DateTime
  leaseMonths    Int

  message   String?
  expiresAt DateTime?

  acceptedAt DateTime?
  declinedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentRequest PaymentRequest?
  leaseAgreement LeaseAgreement?

  application Application @relation(fields: [applicationId], references: [id])
  property    Property    @relation(fields: [propertyId], references: [id])
  applicant   User        @relation(fields: [applicantId], references: [id])

  @@unique([applicationId])
}

model PaymentRequest {
  id          String @id @default(uuid())
  offerId     String @unique
  propertyId  String
  applicantId String

  bondAmount  Decimal @db.Decimal(12, 2)
  advanceRent Decimal @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)

  status  PaymentRequestStatus @default(PENDING)
  dueDate DateTime
  paidAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  applicant User     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

model LeaseAgreement {
  id          String @id @default(uuid())
  offerId     String @unique
  propertyId  String
  applicantId String

  status LeaseAgreementStatus @default(DRAFT)

  leaseStartDate DateTime
  leaseEndDate   DateTime
  leaseMonths    Int

  weeklyRent  Decimal @db.Decimal(12, 2)
  bondAmount  Decimal @db.Decimal(12, 2)
  advanceRent Decimal @db.Decimal(12, 2)

  // External signing tracking
  agreementUrl      String?
  externalProvider  String? // "DocuSign", "Email", "Adobe"
  externalReference String? // envelopeId / docId etc.

  sentAt      DateTime?
  signedAt    DateTime?
  cancelledAt DateTime?

  // Audit
  createdById String?
  sentById    String?
  signedById  String?

  tenancy Tenancy?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  applicant User     @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  createdBy User? @relation("LeaseCreatedBy", fields: [createdById], references: [id])
  sentBy    User? @relation("LeaseSentBy", fields: [sentById], references: [id])
  signedBy  User? @relation("LeaseSignedBy", fields: [signedById], references: [id])
}

model Tenancy {
  id               String @id @default(uuid())
  leaseAgreementId String @unique
  propertyId       String
  tenantId         String
  agencyId         String

  status TenancyStatus @default(ACTIVE)

  startDate DateTime
  endDate   DateTime

  weeklyRent  Decimal @db.Decimal(12, 2)
  bondAmount  Decimal @db.Decimal(12, 2)
  advanceRent Decimal @db.Decimal(12, 2)

  endedAt     DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaseAgreement LeaseAgreement @relation(fields: [leaseAgreementId], references: [id], onDelete: Cascade)
  property       Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant         User           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agency         Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
}
